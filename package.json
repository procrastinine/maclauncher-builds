{
  "name": "maclauncher-builds",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "pack": "node tools/runtime-package.mjs pack",
    "verify": "node tools/runtime-package.mjs verify",
    "catalog": "node tools/runtime-package.mjs catalog",
    "check:updates": "node tools/check-updates.mjs",
    "release:prepare": "node tools/release-runtime.mjs prepare",
    "release:verify": "node tools/release-runtime.mjs verify",
    "release:catalog": "node tools/release-runtime.mjs apply",
    "release:stage": "node tools/release-runtime.mjs stage",
    "index:build": "node tools/package-index.mjs --output dist/package-index",
    "check:versions": "node tools/check-release-versions.mjs",
    "release:batch": "node tools/release-batch.mjs"
  },
  "dependencies": {
    "@sigstore/bundle": "5.0.0",
    "@sigstore/core": "4.0.1",
    "@sigstore/protobuf-specs": "0.5.0",
    "@sigstore/verify": "4.1.0"
  }
}
