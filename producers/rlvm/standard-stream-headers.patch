+++ b/src/systems/base/gan_graphics_object_data.cc
@@ -37,6 +37,7 @@
 
 #include <boost/serialization/export.hpp>
 #include <boost/filesystem/fstream.hpp>
+#include <iostream>
 #include <string>
 #include <vector>
 
