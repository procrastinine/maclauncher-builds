RLVM: include the Boost header that defines directory iterators.

The selected Boost operations/path headers no longer provide the directory
iterator definition transitively. Include its owning header directly without
changing save enumeration or filesystem operations. Upstream RLVM copyright
and GPL-3.0-or-later notices remain unchanged.

diff --git a/src/modules/module_sys_save.cc b/src/modules/module_sys_save.cc
--- a/src/modules/module_sys_save.cc
+++ b/src/modules/module_sys_save.cc
@@ -29,6 +29,7 @@
 #include "modules/module_sys_save.h"
 
 #include <boost/algorithm/string/predicate.hpp>
+#include <boost/filesystem/directory.hpp>
 #include <boost/filesystem/fstream.hpp>
 #include <boost/filesystem/operations.hpp>
 #include <boost/filesystem/path.hpp>
