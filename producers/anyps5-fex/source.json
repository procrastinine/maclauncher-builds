  "overlays": [
    {
      "file": "overlays/fex/0001-darwin-core.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "FEXCore for an embedding host on arm64 macOS: Darwin platform boundary, MAP_JIT allocations with per-thread write scopes, x18 kept out of register allocation"
    },
    {
      "file": "overlays/fex/0002-darwin-code-guards.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "host-page guards for code buffers; the final owned MAP_JIT page replaced by an inaccessible mapping"
    },
    {
      "file": "overlays/fex/0003-darwin-signals-and-guest-state.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "FEXCore/Darwin/SignalDelegator.h and GuestState.h: signal installation, code-write faults, guest exception delivery, per-thread guest binding and CPU accessors"
    },
    {
      "file": "overlays/fex/0004-darwin-context-state.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "FEXCore/Darwin/ContextState.h: guest register and FXSAVE64 capture and restore for the embedding library"
    },
    {
      "file": "overlays/fex/0005-darwin-single-step-writes.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "scoped JIT writes for single-instruction compilation"
    },
    {
      "file": "overlays/fex/0006-x87-status.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "x87 exception status kept through environment restoration, status reads, FNCLEX and FNINIT (Avery Felts, MetalSharp-Wine FEX series)"
    },
    {
      "file": "overlays/fex/0007-precise-memory-pop.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "RSP committed after a memory POP store succeeds (Alexander Thei\u00dfen, Mach9 FEX fork)"
    },
    {
      "file": "overlays/fex/0008-darwin-interrupt-page.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "the interrupt fault page sized and aligned to the 16 KiB Darwin host page, so it can be protected on its own; the host enables the interrupt check through the GdbServer option, whose only FEXCore use is this check"
    },
    {
      "file": "overlays/fex/0009-taken-backward-branch-interrupt-check.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "the interrupt check on every taken backward conditional branch, as on an unconditional one"
    },
    {
      "file": "overlays/fex/0010-x87-control-read.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "Reserved x87 control-word bits are masked on stores and Darwin state reads while preserving the loaded word"
    },
    {
      "file": "overlays/fex/0011-x87-quiet-compare.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "Quiet x87 comparisons distinguish signaling inputs and unsupported encodings"
    },
    {
      "file": "overlays/fex/0012-smc-direction.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "Changed direction flags are written back at guest instruction boundaries"
    },
    {
      "file": "overlays/fex/0013-smc-vector-cache.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "Cached MMX and upper YMM state is retained at writable code instruction boundaries"
    },
    {
      "file": "overlays/fex/0014-exact-x87-remainders.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "Full 80-bit FPREM and FPREM1 reductions preserve quotient bits and denormal operands"
    },
    {
      "file": "overlays/fex/0015-x87-rounding-controls.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "MXCSR controls FTZ and DAZ independently of x87 control operations"
    },
    {
      "file": "overlays/fex/0016-x86-undefined-flags.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "Arithmetic flags left undefined follow the selected x86 behavior"
    },
    {
      "file": "overlays/fex/0017-signed-memory-loads.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "MOVSX and MOVSXD signed memory loads retain software TSO and destination width"
    },
    {
      "file": "overlays/fex/0018-signed-load-offsets.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "Signed-load displacement inlining uses the memory access size with its paired load operation"
    },
    {
      "file": "overlays/fex/0019-darwin-zero-anonymous-caches.patch",
      "target": "fex",
      "license": "MIT",
      "summary": "Darwin anonymous cache invalidation clears resident entries with exact host-page edges"
    },
    {
      "file": "overlays/anyps5/guestcpu-arm64.patch",
      "target": "anyps5",
      "license": "GPL-2.0-only",
      "summary": "GuestCpu.hpp arm64 branch: guest x86 state accessors supplied by the host, counter-timer TSC"
    }
