diff --git a/FEXCore/include/FEXCore/Utils/JITWriteScope.h b/FEXCore/include/FEXCore/Utils/JITWriteScope.h
new file mode 100644
index 000000000..27d40bb67
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/JITWriteScope.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <cstdint>
+
+#ifdef __APPLE__
+#include <pthread.h>
+#endif
+
+namespace FEXCore::Utils {
+// Darwin maps the code buffers MAP_JIT. A thread may write them only in write mode and run them only in execute
+// mode (pthread_jit_write_protect_np, per thread). Every C++ path that emits, copies or patches host code holds this
+// scope; scopes nest per thread and the outermost one returns the thread to execute mode. Elsewhere it is empty.
+class JITWriteScope final {
+public:
+#ifdef __APPLE__
+  JITWriteScope() {
+    if (Depth++ == 0) {
+      pthread_jit_write_protect_np(0);
+    }
+  }
+  ~JITWriteScope() {
+    if (--Depth == 0) {
+      pthread_jit_write_protect_np(1);
+    }
+  }
+private:
+  static inline thread_local uint32_t Depth = 0;
+#else
+  JITWriteScope() {}
+#endif
+public:
+  JITWriteScope(const JITWriteScope&) = delete;
+  JITWriteScope& operator=(const JITWriteScope&) = delete;
+};
+} // namespace FEXCore::Utils
