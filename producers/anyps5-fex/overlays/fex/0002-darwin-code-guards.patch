diff --git a/FEXCore/include/FEXCore/Utils/MemoryGuard.h b/FEXCore/include/FEXCore/Utils/MemoryGuard.h
new file mode 100644
index 00000000..0a79a688
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/MemoryGuard.h
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <FEXCore/Utils/TypeDefines.h>
+#include <cstdint>
+
+#ifdef __APPLE__
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+namespace FEXCore::Utils {
+inline size_t CodeGuardSize() {
+#ifdef __APPLE__
+  return static_cast<size_t>(getpagesize());
+#else
+  return FEX_PAGE_SIZE;
+#endif
+}
+
+#ifdef __APPLE__
+// Replace only the owned final host page. This creates an ordinary PROT_NONE mapping atomically,
+// without mprotect on MAP_JIT memory or a forbidden MAP_FIXED | MAP_JIT allocation.
+inline bool InstallDarwinJITGuard(void* Allocation, size_t Size) {
+  const size_t Page = CodeGuardSize();
+  const auto Base = reinterpret_cast<uintptr_t>(Allocation);
+  if (!Allocation || Base % Page || Size < Page || Size % Page) { return false; }
+  void* Guard = reinterpret_cast<void*>(Base + Size - Page);
+  return mmap(Guard, Page, PROT_NONE, MAP_PRIVATE | MAP_ANON | MAP_FIXED, -1, 0) == Guard;
+}
+#endif
+} // namespace FEXCore::Utils
