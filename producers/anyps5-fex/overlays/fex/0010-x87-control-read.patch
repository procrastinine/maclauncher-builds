+++ b/FEXCore/include/FEXCore/Darwin/GuestState.h
@@ -67,7 +67,7 @@ inline void SetMxcsr(uint32_t Value) {
 }
 // This is the mask emitted by the selected FEXCore FXSAVE/XSAVE implementation.
 inline uint32_t MxcsrMask() { return 0xffc0; }
-inline uint16_t X87Control() { return State().FCW; }
