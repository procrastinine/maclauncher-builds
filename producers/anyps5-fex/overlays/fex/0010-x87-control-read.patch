From fa4f65e2546931869554029cdf1472b49afb6863 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Alexander=20Thei=C3=9Fen?= <alex@theissen.io>
Date: Sat, 31 Oct 2026 19:48:31 +0800
Subject: [PATCH 22/47] FEXCore, Windows: Read the x87 control word as hardware
 does

Hardware reads bit 6 of the control word as one and bits 7, 13, 14 and
15 as zero, whatever was loaded. FEX gave back the word as loaded. In
World of Warcraft 3.3.5a a DLL's CRT loads 0x23f, the CRT in the
executable then fails its FNSTCW & 0x7f == 0x7f test and takes the x87
path of floor, with two FPCR changes per call.

- CPUState keeps the word as loaded, so FLDCW, FLDENV, FRSTOR, FXRSTOR
  and XRSTOR are unchanged.
- FNSTCW, FNSTENV, FNSAVE, FXSAVE and XSAVE apply the mask, as do the
  WOW64 and ARM64EC contexts and Linux signal frames.
- The JIT, softfloat and FPCR code read only the rounding and precision
  fields, which the mask keeps.

The InstructionCountCI listings are not regenerated: CodeSizeValidation
needs a Linux host.

License: MIT. Core adaptation retains the original author and source commit.

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
index 08b53ef..1d27413 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
@@ -3065,10 +3065,7 @@ void OpDispatchBuilder::SaveX87State(OpcodeArgs, Ref MemBase) {
     //   16 | FDP[31:0] | FDS         | <R> | MXCSR     | MXCSR_MASK|
   }
 
-  {
-    auto FCW = _LoadContextGPR(OpSize::i16Bit, offsetof(FEXCore::Core::CPUState, FCW));
-    _StoreMemGPR(OpSize::i16Bit, MemBase, FCW, OpSize::i16Bit);
-  }
+  { _StoreMemGPR(OpSize::i16Bit, MemBase, ReconstructFCW_Helper(), OpSize::i16Bit); }
 
   { _StoreMemGPR(OpSize::i16Bit, ReconstructFSW_Helper(), MemBase, Constant(2), OpSize::i16Bit, MemOffsetType::SXTX, 1); }
 
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
index f3e9903..cec315e 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
@@ -399,10 +399,7 @@ void OpDispatchBuilder::X87FNSTENV(OpcodeArgs) {
   Ref Mem = LoadSourceGPR(Op, Op->Dest, Op->Flags, {.LoadData = false});
   Mem = AppendSegmentOffset(Mem, Op->Flags);
 
-  {
-    auto FCW = _LoadContextGPR(OpSize::i16Bit, offsetof(FEXCore::Core::CPUState, FCW));
-    _StoreMemGPR(Size, Mem, FCW, Size);
-  }
+  { _StoreMemGPR(Size, Mem, ReconstructFCW_Helper(), Size); }
 
   { _StoreMemGPR(Size, ReconstructFSW_Helper(), Mem, Constant(IR::OpSizeToSize(Size) * 1), Size, MemOffsetType::SXTX, 1); }
 
@@ -506,10 +503,7 @@ void OpDispatchBuilder::X87FNSAVE(OpcodeArgs) {
   const auto Size = OpSizeFromDst(Op);
   Ref Mem = MakeSegmentAddress(Op, Op->Dest);
   Ref Top = GetX87Top();
-  {
-    auto FCW = _LoadContextGPR(OpSize::i16Bit, offsetof(FEXCore::Core::CPUState, FCW));
-    _StoreMemGPR(Size, Mem, FCW, Size);
-  }
+  { _StoreMemGPR(Size, Mem, ReconstructFCW_Helper(), Size); }
 
   { _StoreMemGPR(Size, ReconstructFSW_Helper(), Mem, Constant(IR::OpSizeToSize(Size) * 1), Size, MemOffsetType::SXTX, 1); }
 
@@ -630,10 +624,15 @@ void OpDispatchBuilder::X87FRSTOR(OpcodeArgs) {
   _StoreContextFPRIndexed(Reg, Top, StoreSize, MMBaseOffset(), IR::OpSizeToSize(OpSize::i128Bit));
 }
 
+// The control word as the guest reads it, see FPState::ReconstructFCW.
+Ref OpDispatchBuilder::ReconstructFCW_Helper() {
+  Ref FCW = _LoadContextGPR(OpSize::i16Bit, offsetof(FEXCore::Core::CPUState, FCW));
+  return _Or(OpSize::i32Bit, _And(OpSize::i32Bit, FCW, Constant(FPState::FCWReadMask)), Constant(FPState::FCWReadSet));
+}
+
 // Load / Store Control Word
 void OpDispatchBuilder::X87FSTCW(OpcodeArgs) {
-  auto FCW = _LoadContextGPR(OpSize::i16Bit, offsetof(FEXCore::Core::CPUState, FCW));
-  StoreResultGPR(Op, FCW);
+  StoreResultGPR(Op, ReconstructFCW_Helper());
 }
 
 void OpDispatchBuilder::X87FLDCW(OpcodeArgs) {
