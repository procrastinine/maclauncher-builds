License: MIT

Sizes and aligns the thread's interrupt fault page to the 16 KiB Darwin host page. The embedding host enables
FEXCore's interrupt check through the GdbServer option, because that option's only use in FEXCore is this check.

diff --git a/FEXCore/include/FEXCore/Debug/InternalThreadState.h b/FEXCore/include/FEXCore/Debug/InternalThreadState.h
index 42feabb..89a09b0 100644
--- a/FEXCore/include/FEXCore/Debug/InternalThreadState.h
+++ b/FEXCore/include/FEXCore/Debug/InternalThreadState.h
@@ -87,7 +87,14 @@ struct UnalignedExclusiveStore {
   uint8_t Size;
 };
 
-struct alignas(FEXCore::Utils::FEX_PAGE_SIZE) InternalThreadState : public FEXCore::Allocator::FEXAllocOperators {
+// The interrupt fault page is protected as one whole host page: Darwin arm64 protects memory in 16 KiB pages.
+#ifdef __APPLE__
+inline constexpr size_t InterruptFaultPageSize = 16384;
+#else
+inline constexpr size_t InterruptFaultPageSize = FEXCore::Utils::FEX_PAGE_SIZE;
+#endif
+
+struct alignas(InterruptFaultPageSize) InternalThreadState : public FEXCore::Allocator::FEXAllocOperators {
   FEXCore::Core::CpuStateFrame* const CurrentFrame = &BaseFrameState;
 
   FEXCore::Context::Context* const CTX;
@@ -122,7 +129,7 @@ struct alignas(FEXCore::Utils::FEX_PAGE_SIZE) InternalThreadState : public FEXCo
   FEXCore::Core::CpuStateFrame BaseFrameState {};
 
   // Can be reprotected as RO to trigger an interrupt at generated code block entrypoints
-  alignas(FEXCore::Utils::FEX_PAGE_SIZE) uint8_t InterruptFaultPage[FEXCore::Utils::FEX_PAGE_SIZE];
+  alignas(InterruptFaultPageSize) uint8_t InterruptFaultPage[InterruptFaultPageSize];
 };
 static_assert(std::is_standard_layout_v<FEXCore::Core::InternalThreadState>);
 // Maximum unsigned-offset store range for fault page.
