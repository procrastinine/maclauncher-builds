{
  "schemaVersion": 1,
  "id": "android-java-framework",
  "version": "16.0.0-MCLv4",
  "sources": [
    {
      "id": "apacheHttp",
      "repository": "https://android.googlesource.com/platform/external/apache-http",
      "pin": "aospApacheHttp",
      "prefetch": [
        "Android.bp",
        "src",
        "android/src"
      ]
    },
    {
      "id": "statsd",
      "repository": "https://android.googlesource.com/platform/packages/modules/StatsD",
      "pin": "aospStatsd",
      "prefetch": [
        "service"
      ]
    },
    {
      "id": "framework",
      "repository": "https://android.googlesource.com/platform/frameworks/base",
      "pin": "aospFramework",
      "prefetch": [
        "core/jni"
      ]
    },
    {
      "id": "native",
      "repository": "https://android.googlesource.com/platform/frameworks/native",
      "pin": "aospNative",
      "prefetch": [
        "opengl/libs/ETC1",
        "opengl/include/ETC1",
        "include/android/bitmap.h"
      ]
    }
  ]
}
