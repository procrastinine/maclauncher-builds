{
  "id": "android-launcher",
  "version": "1.0.0-MCLv3",
  "arch": "universal",
  "launcherArchitectures": [
    "arm64",
    "x64"
  ],
  "minimumMacOS": "13.0",
  "source": {
    "repository": "https://github.com/procrastinine/maclauncher-builds"
  },
  "inputs": [
    {
      "path": "resources/launch-arguments.jar",
      "output": "files/resources/launch-arguments.jar",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "resources/text-input.jar",
      "output": "files/resources/text-input.jar",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "resources/text-input.json",
      "output": "files/resources/text-input.json",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "store/resources/account-control.jar",
      "output": "files/store/resources/account-control.jar",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "store/resources/account-control.json",
      "output": "files/store/resources/account-control.json",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "providers/macapk/resources/privacy.jar",
      "output": "files/providers/macapk/resources/privacy.jar",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "runtime/package.json",
      "output": "files/runtime/package.json",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "runtime/src/modules/android/apk.js",
      "output": "files/runtime/src/modules/android/apk.js",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "runtime/src/modules/android/binary-manifest.js",
      "output": "files/runtime/src/modules/android/binary-manifest.js",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "runtime/src/modules/android/profile.js",
      "output": "files/runtime/src/modules/android/profile.js",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "runtime/src/modules/android/art/runtime.js",
      "output": "files/runtime/src/modules/android/art/runtime.js",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "runtime/src/modules/android/art/boot-classpath.mjs",
      "output": "files/runtime/src/modules/android/art/boot-classpath.mjs",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "runtime/src/modules/android/art/components.json",
      "output": "files/runtime/src/modules/android/art/components.json",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "runtime/src/modules/android/art/supplier.json",
      "output": "files/runtime/src/modules/android/art/supplier.json",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "runtime/src/modules/android/native/arm32/components.json",
      "output": "files/runtime/src/modules/android/native/arm32/components.json",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "runtime/src/modules/android/native/resources/ad-hosts.json",
      "output": "files/runtime/src/modules/android/native/resources/ad-hosts.json",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "runtime/src/modules/android/native/resources/storage-namespace.json",
      "output": "files/runtime/src/modules/android/native/resources/storage-namespace.json",
      "kind": "file",
      "mode": 420
    },
    {
      "path": "runtime/src/modules/shared/runtime/zip.js",
      "output": "files/runtime/src/modules/shared/runtime/zip.js",
      "kind": "file",
      "mode": 420
