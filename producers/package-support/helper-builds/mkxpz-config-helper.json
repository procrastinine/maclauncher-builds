{
  "schemaVersion": 1,
  "id": "mkxpz-config-helper",
  "version": "1.1.0",
  "compiler": "clang",
  "kind": "dylib",
  "output": "mkxpz-config.dylib",
  "sources": [
    "app:src/modules/rgss/overlays/mkxpz-config.c",
    "app:src/modules/rgss/overlays/mkxpz-identity.m"
  ],
  "flags": [
    "-O2",
    "-Wall",
    "-Wextra",
    "-install_name",
    "@rpath/mkxpz-config.dylib",
    "-fobjc-arc"
  ],
  "frameworks": [
    "Foundation",
    "AppKit",
    "ImageIO"
  ],
  "minimumMacOS": "11.0",
  "record": {
    "scope": "selected-executable-config-and-display-identity"
  }
}
