{
  "schema": 1,
  "pins": {
    "dxmt-templates": [
      {
        "version": "1.0.21",
        "asset": {
          "url": "https://github.com/Sikarugir-App/Template/releases/download/v1.0/Template-1.0.21.tar.xz",
          "sha256": "bbe996e4e4375318485953d0c7818b7b4b0a4dc1f13303bcc584f99f7602f78d"
        },
        "cameraBridge": {
          "nativeSha256": "62dbce6c66f23308fcdf58fba7371271b0412a71074ad7add87a801516ce473a",
          "thunkSha256": "e176504a3ee9d79d0f1b455141d79ed5f0355ce8ecf99317001ffd5d8e620367"
        }
      }
    ]
  },
  "core": {
    "materialize": "src/modules/shared/reshade/native/materialize-source.mjs",
    "macOSSDK": "27.0",
    "configure": {
      "CMAKE_BUILD_TYPE": "Release",
      "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
      "BUILD_TESTING": "OFF"
    },
    "targets": [
      "reshade-macos",
      "fx-compile",
      "shaderc-offline",
      "maclauncher-graphics-video",
      "maclauncher-graphics-hardware",
      "maclauncher-graphics-window"
    ],
    "macOSSDKByArchitecture": {
      "arm64": "27.0",
      "universal": "27.0",
      "x64": "26.0"
    },
    "minimumMacOS": "13.0"
  },
  "sources": {
    "fsr2": {
      "path": "src/external/fsr2",
      "pin": {
        "file": "app:src/modules/shared/reshade/temporal/fsr/source.json",
        "repository": "/fsr2/repository"
      }
    },
    "fsr3-sdk": {
      "path": "src/external/fsr3-sdk",
      "pin": {
        "file": "app:src/modules/shared/reshade/generation/fsr3/source.json",
        "repository": "/repository"
      }
    },
    "fsr4": {
      "path": "src/external/fsr4-metal",
      "pin": {
        "file": "app:src/modules/shared/reshade/temporal/fsr4/source.json",
        "repository": "/repository"
      }
    },
    "asr": {
      "path": "src/external/asr",
      "pin": {
        "file": "app:src/modules/shared/reshade/temporal/asr/source.json",
        "repository": "/repository"
      }
    },
    "sgsr2": {
      "path": "src/external/sgsr2",
      "pin": {
        "file": "app:src/modules/shared/reshade/temporal/sgsr2/source.json",
        "repository": "/repository"
      }
    },
    "godot": {
      "path": "src/external/godot-camera",
      "pin": {
        "file": "app:src/modules/godot/graphics/source.json",
        "repository": "/repository"
      }
    },
    "streamline": {
      "path": "src/external/streamline-camera",
      "pin": {
        "file": "src/modules/crossover/temporal/streamline/source.json",
        "repository": "/repository"
      }
    },
    "dxmt": {
      "path": "src/external/dxmt-camera",
      "pin": {
        "file": "src/modules/crossover/temporal/dxmt/source.json",
        "repository": "/repository"
      }
    },
    "xess": {
      "path": "src/external/xess",
      "pin": {
        "file": "app:src/modules/shared/reshade/xess/source.json",
        "repository": "/repository"
      }
    },
    "sdl-vulkan": {
      "path": "src/external/shared-sdl-headers",
      "pin": {
        "file": "src/modules/shared/reshade/xess/native/vulkan-source.json",
        "repository": "/repository"
      }
    },
    "librashader": {
      "path": "src/external/librashader",
      "pin": {
        "file": "src/modules/shared/reshade/native/retroarch-source.json",
        "repository": "/repository"
      }
    },
    "mlx-dlss": {
      "path": "src/external/MLX-DLSS",
      "pin": {
        "file": "app:src/modules/shared/reshade/neural/source.json",
        "repository": "/repository"
      }
    },
    "isfmslkit": {
      "path": "src/external/ISFMSLKit",
      "pin": {
        "file": "src/modules/shared/reshade/isf/source.json",
        "repository": "/sources/0/repository"
      }
    },
    "libplacebo": {
      "path": "src/external/libplacebo",
      "match": "object",
      "pin": {
        "file": "src/modules/shared/reshade/libplacebo/scene-profile.json",
        "repository": "/SOURCE/origin"
      }
    },
    "libplacebo-vulkan-headers": {
      "path": "src/external/libplacebo/3rdparty/Vulkan-Headers",
      "match": "object",
      "pin": {
        "file": "src/modules/shared/reshade/libplacebo/scene-profile.json",
        "repository": "/VULKAN_HEADERS/origin"
      }
    }
  },
  "inputs": {
    "shader-tools": {
      "kind": "directory",
      "description": "DXC, SPIRV-Cross and SPIRV-Tools validator binaries vendored by the pinned FSR 4 source",
      "from": {
        "source": "fsr4",
        "path": "tools/bin"
      },
      "files": {
        "dxc": "cb0a0535c212ac31ca25ff18a3c43270d9a7c379fb2f3c28692cf8c44afee09d",
        "spirv-cross": "00c168bc2bb03a96943023656007591915057e4d1820dd79d8efa32c75628403",
        "spirv-val": "5e6ad0282e525bde7a764bfa3c0de5beca5cf65615fbc5def854c54d13bb9f67",
        "../lib/libdxcompiler.dylib": "cc0b66603f5a8cde1e8c9d2789a4e4e2bf99cae7f0705423d4e19fe36afee8a1"
      }
    },
    "llvm-mingw": {
      "kind": "archive",
      "description": "LLVM-MinGW universal macOS toolchain",
      "pin": {
        "file": "../dependencies.json",
        "pointer": "/llvmMingw"
      },
      "url": "{repository}/releases/download/{version}/{asset}",
      "sha256": "{sha256}",
      "entry": "llvm-mingw-{version}-ucrt-macos-universal/bin",
      "files": {
        "x86_64-w64-mingw32-clang": null,
        "x86_64-w64-mingw32-clang++": null
      }
    },
    "lite2-weights": {
      "kind": "file",
      "description": "FSR 4 Lite 2 trained weights",
      "pin": {
        "file": "src/modules/shared/reshade/temporal/fsr4/lite2.json",
        "pointer": ""
      },
      "url": "{repository}/raw/{revision}/{path}",
      "sha256": "{sha256}"
    },
    "streamline-reference": {
      "kind": "archive",
      "description": "Official 64-bit sl.interposer.dll from the Streamline 2.9.0 SDK",
      "url": "https://github.com/NVIDIA-RTX/Streamline/releases/download/v2.9.0/streamline-sdk-v2.9.0.zip",
      "sha256": "b7e4f31706cfacafba95d2d4abc2c9dcf2dc5fc58b2a6917c71f83051d271aa1",
      "entry": "bin/x64/sl.interposer.dll",
      "extract": true,
      "fileSha256": "48f79bdd8eb35d6de0e54a70799a3340913990ef5e0e3a837a4f724008d5685b"
    },
    "dxmt-wine": {
      "kind": "archive",
      "description": "Wine directory of the selected DXMT renderer, containing x86_64-windows and x86_64-unix libraries",
      "pin": {
        "file": "scripts/graphics-runtime.json",
        "pointer": "/pins/dxmt-templates",
        "match": {
          "version": "1.0.21"
        }
      },
      "url": "{asset.url}",
      "sha256": "{asset.sha256}",
      "entry": "Template-{version}.app/Contents/Frameworks/renderer/dxmt/wine",
      "extract": true,
      "files": {
        "x86_64-unix/winemetal.so": "{cameraBridge.nativeSha256}",
        "x86_64-windows/winemetal.dll": "{cameraBridge.thunkSha256}",
        "x86_64-windows/d3d11.dll": null
      }
    },
    "moltenvk": {
      "kind": "archive",
      "description": "MoltenVK release directory whose dynamic macOS library matches libplacebo-build.mjs",
      "pin": {
        "file": "src/modules/shared/reshade/libplacebo-build.mjs",
        "pointer": "/MOLTENVK"
      },
      "url": "{archive.url}",
      "sha256": "{archive.sha256}",
      "entry": "",
      "files": {
        "MoltenVK/MoltenVK/dynamic/dylib/macOS/libMoltenVK.dylib": "{sha256}"
      }
    },
    "core-headers": {
      "kind": "directory",
      "description": "Materialized core source headers included by the libplacebo adapter",
      "product": {
        "provider": "core",
        "path": "source/src"
      }
    },
    "shaderc-library": {
      "kind": "file",
      "description": "Prepared shader compiler library with the CPU slices of the graphics build",
      "product": {
        "provider": "libplacebo",
        "path": "output/libplacebo/libshaderc_shared.1.dylib"
      }
    },
    "shaderc-offline": {
      "kind": "file",
      "description": "Offline shader compiler from the core build",
      "product": {
        "provider": "core",
        "path": "build/shaderc-offline"
      }
    },
    "isf-glslang": {
      "kind": "archive",
      "description": "Original glslang compiler source for ISF",
      "pin": {
        "file": "src/modules/shared/reshade/isf/source.json",
        "pointer": "/compilerSources/0"
      },
      "url": "{repository}/archive/{revision}.tar.gz",
      "sha256": "{sha256}",
      "entry": "glslang-{revision}"
    },
    "isf-spirv-cross": {
      "kind": "archive",
      "description": "Original spirv-cross compiler source for ISF",
      "pin": {
        "file": "src/modules/shared/reshade/isf/source.json",
        "pointer": "/compilerSources/1"
      },
      "url": "{repository}/archive/{revision}.tar.gz",
      "sha256": "{sha256}",
      "entry": "SPIRV-Cross-{revision}"
    },
    "isf-spirv-tools": {
      "kind": "archive",
      "description": "Original spirv-tools compiler source for ISF",
      "entry": "source/spirv-tools"
    },
    "isf-spirv-headers": {
      "kind": "archive",
      "description": "Original spirv-headers compiler source for ISF",
      "entry": "source/spirv-headers"
    },
    "fsr-glslang": {
      "kind": "archive",
      "description": "Source-built host compiler for the pinned FSR shader generator",
      "entry": "source/glslang",
      "files": {
        "CMakeLists.txt": null,
        "glslang/CMakeLists.txt": null
      }
    }
  },
  "tools": {
    "cmake": {
      "command": "cmake"
    },
    "cargo": {
      "command": "cargo"
    },
    "swift": {
      "command": "swift"
    },
    "uv": {
      "command": "uv"
    },
    "meson": {
      "command": "meson"
    },
    "ninja": {
      "command": "ninja"
    },
    "python": {
      "command": "python3"
    }
  },
  "providers": {
    "libplacebo": {
      "option": "--libplacebo",
      "payload": "output",
      "tools": [
        "meson",
        "ninja"
      ],
      "steps": [
        {
          "recipe": "src/modules/shared/reshade/libplacebo-build.mjs",
          "args": [
            "--source",
            "{source:libplacebo}",
            "--vulkan-source",
            "{source:libplacebo-vulkan-headers}",
            "--moltenvk",
            "{input:moltenvk}",
            "--headers",
            "{input:core-headers}",
            "--meson",
            "{tool:meson}",
            "--ninja",
            "{tool:ninja}",
            "--work",
            "{work}",
            "--output",
            "{output}",
            "--arch",
            "{arch}",
            "--python",
            "{tool:python}"
          ]
        }
      ]
    },
    "fsr": {
      "option": "--fsr",
      "payload": "output/payload",
      "steps": [
        {
          "recipe": "src/modules/shared/reshade/temporal/fsr/build.mjs",
          "phased": true,
          "args": [
            "{source:fsr2}",
            "{input:shader-tools}",
            "{output}"
          ]
        },
        {
          "recipe": "src/modules/shared/reshade/temporal/fsr/build.mjs",
          "phased": true,
          "args": [
            "{source:fsr3-sdk}",
            "{input:shader-tools}",
            "{output}",
            "--fsr3"
          ]
        }
      ]
    },
    "fsr4": {
      "option": "--fsr4",
      "sourceOption": [
        "--fsr4-source",
        "fsr4"
      ],
      "payload": "output/payload",
      "tools": [
        "uv",
        "python"
      ],
      "steps": [
        {
          "recipe": "src/modules/shared/reshade/temporal/fsr4/build.mjs",
          "args": [
            "{source:fsr4}",
            "{output}",
            "--tools",
            "{input:shader-tools}",
            "--lite2-weights",
            "{input:lite2-weights}"
          ]
        }
      ]
    },
    "asr": {
      "option": "--asr",
      "sourceOption": [
        "--asr-source",
        "asr"
      ],
      "payload": "output",
      "steps": [
        {
          "recipe": "src/modules/shared/reshade/temporal/asr/build.mjs",
          "args": [
            "--source",
            "{source:asr}",
            "--tools",
            "{input:shader-tools}",
            "--output",
            "{output}"
          ]
        }
      ]
    },
    "sgsr2": {
      "option": "--sgsr2",
      "sourceOption": [
        "--sgsr2-source",
        "sgsr2"
      ],
      "payload": "output",
      "steps": [
        {
          "recipe": "src/modules/shared/reshade/temporal/sgsr2/build.mjs",
          "args": [
            "--source",
            "{source:sgsr2}",
            "--tools",
            "{input:shader-tools}",
            "--shaderc-library",
            "{input:shaderc-library}",
            "--shaderc-headers",
            "app:src/modules/shared/reshade/native",
            "--output",
            "{output}"
          ]
        }
      ]
    },
    "fsr3-generation": {
      "option": "--fsr3-generation",
      "payload": "output/payload",
      "steps": [
        {
          "recipe": "src/modules/shared/reshade/generation/fsr3/build.mjs",
          "phased": true,
          "args": [
            "{source:fsr3-sdk}",
            "{input:shader-tools}",
            "{output}"
          ]
        }
      ]
    },
    "godot": {
      "option": "--godot",
      "payload": "output",
      "steps": [
        {
          "recipe": "src/modules/godot/graphics/build.mjs",
          "args": [
            "{source:godot}",
            "{output}",
            "--shaderc",
            "{input:shaderc-offline}",
            "--shaderc-library",
            "{input:shaderc-library}"
          ]
        }
      ]
    },
    "xess": {
      "option": "--xess",
      "payload": "output",
      "steps": [
        {
          "recipe": "src/modules/crossover/temporal/xess/build.mjs",
          "args": [
            "--xess-source",
            "{source:xess}",
            "--dxmt-source",
            "{source:dxmt}",
            "--compiler",
            "{input:llvm-mingw}/x86_64-w64-mingw32-clang++",
            "--out",
            "{output}"
          ]
        }
      ]
    },
    "streamline": {
      "option": "--streamline",
      "payload": "output",
      "steps": [
        {
          "recipe": "src/modules/crossover/temporal/streamline/build.mjs",
          "args": [
            "--source",
            "{source:streamline}",
            "--out",
            "{output}",
            "--compiler",
            "{input:llvm-mingw}/x86_64-w64-mingw32-clang++",
            "--reference",
            "{input:streamline-reference}"
          ]
        }
      ]
    },
    "dxmt": {
      "option": "--dxmt",
      "payload": "output/payload",
      "marker": "camera-bridge.json",
      "steps": [
        {
          "recipe": "src/modules/crossover/temporal/dxmt/build.mjs",
          "args": [
            "{source:dxmt}",
            "{input:dxmt-wine}",
            "{input:llvm-mingw}",
            "{output}"
          ]
        }
      ]
    },
    "retroarch": {
      "option": "--retroarch",
      "payload": "output",
      "marker": "runtime-files.json",
      "tools": [
        "cargo"
      ],
      "steps": [
        {
          "recipe": "src/modules/shared/reshade/native/build-retroarch.mjs",
          "args": [
            "{source:librashader}",
            "-",
            "{output}",
            "--arch",
            "{arch}"
          ]
        }
      ]
    },
    "neural": {
      "option": "--neural",
      "payload": "output",
      "tools": [
        "swift"
      ],
      "sources": [
        "mlx-dlss"
      ],
      "steps": [
        {
          "recipe": "src/modules/shared/reshade/neural/build.mjs",
          "args": [
            "--work",
            "{work}",
            "--output",
            "{output}",
            "--source",
            "{source:mlx-dlss}",
            "--cache",
            "{work}/swiftpm"
          ]
        }
      ],
      "architectures": [
        "arm64"
      ]
    },
    "isf": {
      "option": "--isf",
      "payload": "output",
      "tools": [
        "cmake"
      ],
      "sources": [
        "isfmslkit"
      ],
      "steps": [
        {
          "recipe": "src/modules/shared/reshade/isf/build.mjs",
          "args": [
            "{work}",
            "--payload",
            "{output}",
            "--source",
            "{source:isfmslkit}",
            "--arch",
            "{arch}",
            "--glslang",
            "{input:isf-glslang}",
            "--spirv-cross",
            "{input:isf-spirv-cross}",
            "--spirv-tools",
            "{input:isf-spirv-tools}",
            "--spirv-headers",
            "{input:isf-spirv-headers}"
          ]
        }
      ]
    },
    "xess-host": {
      "option": "--xess-host",
      "payload": "output",
      "steps": [
        {
          "recipe": "src/modules/shared/reshade/xess/native/build.mjs",
          "args": [
            "--sdk",
            "{source:xess}",
            "--compiler",
            "{input:llvm-mingw}",
            "--vulkan-source",
            "{source:sdl-vulkan}",
            "--out",
            "{output}"
          ]
        }
      ]
    }
  }
}
