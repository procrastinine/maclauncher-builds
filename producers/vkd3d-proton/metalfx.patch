+/* One MetalFX scale (metalfx.c), chained to a barrier after the work recorded before it. A second barrier orders
+ * the work recorded after it. */
+void d3d12_command_list_metalfx_record(struct d3d12_command_list *list, const void *scale,
+        struct d3d12_resource **resources, unsigned int count)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    VkMemoryBarrier2 barrier = { VK_STRUCTURE_TYPE_MEMORY_BARRIER_2 };
+    VkDependencyInfo dependency = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    unsigned int i;
+
+    d3d12_command_list_flush_dgc_batch(list);
+    d3d12_command_list_end_current_render_pass(list, false);
+    d3d12_command_list_end_transfer_batch(list, false);
+    for (i = 0; i < count; i++)
+    {
+        if (resources[i])
+            d3d12_command_list_track_resource_usage(list, resources[i], true);
+    }
+
+    barrier.srcStageMask = barrier.dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    barrier.srcAccessMask = barrier.dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT;
+    dependency.pNext = scale;
+    dependency.memoryBarrierCount = 1;
+    dependency.pMemoryBarriers = &barrier;
+    VK_CALL(vkCmdPipelineBarrier2(list->cmd.vk_command_buffer, &dependency));
+    dependency.pNext = NULL;
+    VK_CALL(vkCmdPipelineBarrier2(list->cmd.vk_command_buffer, &dependency));
+}
