+// whether the initialized device's command lists interpolate frames; Frame Generation is offered only then
+static std::atomic<bool> frame_interpolation;
+
+static void RememberFrameInterpolation(ID3D12Device *device) {
+  ID3D12CommandAllocator *allocator = nullptr;
+  ID3D12GraphicsCommandList *list = nullptr;
+  bool supported = false;
+  if (device &&
+      SUCCEEDED(device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&allocator))) &&
+      SUCCEEDED(device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, allocator, nullptr, IID_PPV_ARGS(&list)))) {
+    MetalFXRef metalfx(list);
+    supported = metalfx.iface && metalfx.iface->lpVtbl->SupportsFrameInterpolation(metalfx.iface);
+  }
+  if (list)
+    list->Release();
+  if (allocator)
+    allocator->Release();
+  frame_interpolation = supported;
+}
