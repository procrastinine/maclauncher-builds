+static void ReadSuperResolution(const ParametersImpl *parameters, const DLSSFeature &dlss,
+                                VKD3D_METALFX_TEMPORAL_DESC &desc) {
+  desc.InputContentWidth = GetOr(parameters, NVNGX_Parameter_DLSS_Render_Subrect_Dimensions_Width, 0u);
+  desc.InputContentHeight = GetOr(parameters, NVNGX_Parameter_DLSS_Render_Subrect_Dimensions_Height, 0u);
+  desc.DepthReversed = bool(dlss.flag & NVNGX_DLSS_FLAG_DEPTH_INVERTED);
+  desc.AutoExposure = bool(dlss.flag & NVNGX_DLSS_FLAG_AUTO_EXPOSURE);
+  desc.MotionVectorInDisplayRes = !bool(dlss.flag & NVNGX_DLSS_FLAG_MV_LOWRES);
+  ReadCommon(parameters, desc.MotionVectorScaleX, desc.MotionVectorScaleY, desc.JitterOffsetX, desc.JitterOffsetY,
+             desc.PreExposure, desc.InReset);
+  desc.ColorX = GetOr(parameters, "DLSS.Input.Color.Subrect.Base.X", 0u);
+  desc.ColorY = GetOr(parameters, "DLSS.Input.Color.Subrect.Base.Y", 0u);
+  desc.DepthX = GetOr(parameters, "DLSS.Input.Depth.Subrect.Base.X", 0u);
+  desc.DepthY = GetOr(parameters, "DLSS.Input.Depth.Subrect.Base.Y", 0u);
+  desc.MotionX = GetOr(parameters, "DLSS.Input.MV.Subrect.Base.X", 0u);
+  desc.MotionY = GetOr(parameters, "DLSS.Input.MV.Subrect.Base.Y", 0u);
+  // the bias-current-color mask is the frame's reactive mask; DLSS reserves its transparency mask
+  desc.ReactiveX = GetOr(parameters, "DLSS.Input.Bias.Current.Color.Subrect.Base.X", 0u);
+  desc.ReactiveY = GetOr(parameters, "DLSS.Input.Bias.Current.Color.Subrect.Base.Y", 0u);
+  if (dlss.enable_output_subrects) {
+    desc.OutputX = GetOr(parameters, "DLSS.Output.Subrect.Base.X", 0u);
+    desc.OutputY = GetOr(parameters, "DLSS.Output.Subrect.Base.Y", 0u);
+  }
+  desc.Hdr = bool(dlss.flag & 1); // NVSDK_NGX_DLSS_Feature_Flags_IsHDR
+  desc.MotionVectorJittered = bool(dlss.flag & NVNGX_DLSS_FLAG_MV_JITTERED);
+  desc.Sharpness = GetOr(parameters, NVNGX_Parameter_Sharpness, 0.0f);
+  float frame_time = GetOr(parameters, "FrameTimeDeltaInMsec", 0.0f);
+  if (temporal_camera.size) {
+    desc.CameraValid = TRUE;
+    desc.DepthInfinite = bool(temporal_camera.flags & RS_TEMPORAL_DEPTH_INFINITE);
+    desc.NearPlane = temporal_camera.nearPlane;
+    desc.FarPlane = temporal_camera.farPlane;
+    desc.VerticalFov = temporal_camera.verticalFov;
+    if (!(frame_time > 0.0f))
+      frame_time = temporal_camera.frameTimeMs;
+  }
+  desc.FrameTimeMs = std::isfinite(frame_time) && frame_time > 0.0f ? frame_time : 0.0f;
+}
