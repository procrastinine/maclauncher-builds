+static void RememberFeatures(ID3D12Device *device) {
+  ID3D12CommandAllocator *allocator = nullptr;
+  ID3D12GraphicsCommandList *list = nullptr;
+  bool sr = false, rr = false, fg = false;
+  if (device &&
+      SUCCEEDED(device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&allocator))) &&
+      SUCCEEDED(device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, allocator, nullptr, IID_PPV_ARGS(&list)))) {
+    MetalFXRef metalfx(list);
+    if (auto m = metalfx.iface) {
+      sr = m->lpVtbl->SupportsTemporalUpscale(m);
+      rr = m->lpVtbl->SupportsDenoisedUpscale(m);
+      fg = m->lpVtbl->SupportsFrameInterpolation(m);
+    }
+  }
+  if (list)
+    list->Release();
+  if (allocator)
+    allocator->Release();
+  super_resolution = sr;
+  ray_reconstruction = rr;
+  frame_interpolation = fg;
+}
