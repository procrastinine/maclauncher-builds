+RSTemporalCamera ExchangeTemporalCamera(const RSTemporalCamera *camera) {
+  RSTemporalCamera previous = temporal_camera;
+  temporal_camera = ValidCamera(camera) ? *camera : RSTemporalCamera{};
+  return previous;
+}
