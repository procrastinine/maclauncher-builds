+// whether the word is one of the driverInfo's
+static bool NamesWord(const char *info, const char *word) {
+  size_t length = strlen(word);
+  for (const char *found = strstr(info, word); found; found = strstr(found + 1, word))
+    if ((found == info || found[-1] == ' ') && (!found[length] || found[length] == ' '))
+      return true;
+  return false;
+}
