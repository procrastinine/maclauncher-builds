+      vulkan ? reinterpret_cast<PFN_vkGetInstanceProcAddr>(GetProcAddress(vulkan, "vkGetInstanceProcAddr")) : nullptr;
+  auto device_proc =
+      instance_proc ? reinterpret_cast<PFN_vkGetDeviceProcAddr>(instance_proc(instance, "vkGetDeviceProcAddr")) : nullptr;
+  auto properties2 = instance_proc ? reinterpret_cast<PFN_vkGetPhysicalDeviceProperties2>(
+                                         instance_proc(instance, "vkGetPhysicalDeviceProperties2"))
+                                   : nullptr;
+  if (device_proc && properties2) {
+    VkPhysicalDeviceDriverProperties driver = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES};
+    VkPhysicalDeviceProperties2 properties = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &driver};
+    properties2(physical, &properties);
+    q->temporal_sr = NamesWord(driver.driverInfo, "temporal-sr") && CreateCommands11(*q, device_proc, family);
+  }
+  queues11.push_back(std::move(q));
+  return queues11.back().get();
+}
+
+static void RememberFeatures(ID3D11Device *device) {
+  Queue11 *queue = GetQueue11(device);
+  super_resolution = queue && queue->temporal_sr;
+}
+
+// the Vulkan image of a DXVK texture, and the format it is read as
+static bool Image11(ID3D11Resource *resource, VkImage &image, VkFormat &format) {
+  IDXGIVkInteropSurface *surface = nullptr;
+  if (FAILED(resource->QueryInterface(__uuidof(IDXGIVkInteropSurface), (void **)&surface)))
+    return false;
+  VkImageCreateInfo info = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+  HRESULT hr = surface->GetVulkanImageInfo(&image, nullptr, &info);
+  surface->Release();
+  format = vk_temporal_read_format(info.format);
+  return SUCCEEDED(hr) && image != VK_NULL_HANDLE;
+}
+
+// records the frame, with the identities released since the last one, in the queue's next command buffer, and
+// submits it after the context's commands
+static bool Submit11(Queue11 &q, IDXGIVkInteropDevice *interop, VkTemporalFrameInfoMVK &info) {
+  std::lock_guard<std::mutex> lock(q.mutex);
+  unsigned slot = q.next;
+  q.next = (slot + 1) % Queue11::SLOTS;
+  if (q.pending[slot]) {
+    q.WaitForFences(q.device, 1, &q.fences[slot], VK_TRUE, UINT64_MAX);
+    q.ResetFences(q.device, 1, &q.fences[slot]);
+    q.pending[slot] = false;
+  }
+  std::vector<uint64_t> released;
+  {
+    std::lock_guard<std::mutex> lock(queues11_mutex);
+    released.swap(released11);
+  }
+  info.releaseFeatureIdCount = uint32_t(released.size());
+  info.pReleaseFeatureIds = released.data();
+  // the frame, then a barrier that orders what the driver writes before the commands after it
+  VkMemoryBarrier2 barrier = {VK_STRUCTURE_TYPE_MEMORY_BARRIER_2};
+  barrier.srcStageMask = barrier.dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+  barrier.srcAccessMask = barrier.dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT;
+  VkDependencyInfo dependency = {VK_STRUCTURE_TYPE_DEPENDENCY_INFO, &info};
+  dependency.memoryBarrierCount = 1;
+  dependency.pMemoryBarriers = &barrier;
+  VkCommandBuffer command = q.commands[slot];
+  VkCommandBufferBeginInfo begin = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO, nullptr,
+                                    VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT};
+  if (q.ResetCommandBuffer(command, 0) != VK_SUCCESS || q.BeginCommandBuffer(command, &begin) != VK_SUCCESS)
+    return false;
+  q.CmdPipelineBarrier2(command, &dependency);
+  dependency.pNext = nullptr;
+  q.CmdPipelineBarrier2(command, &dependency);
+  if (q.EndCommandBuffer(command) != VK_SUCCESS)
+    return false;
+  VkSubmitInfo submit = {VK_STRUCTURE_TYPE_SUBMIT_INFO};
+  submit.commandBufferCount = 1;
+  submit.pCommandBuffers = &command;
+  interop->FlushRenderingCommands();
+  interop->LockSubmissionQueue();
+  VkResult result = q.QueueSubmit(q.queue, 1, &submit, q.fences[slot]);
+  interop->ReleaseSubmissionQueue();
+  q.pending[slot] = result == VK_SUCCESS;
+  return result == VK_SUCCESS;
+}
