+// MacLauncher's Streamline proxy hands the game's camera to the evaluation on this thread through
+// MacLauncherSetTemporalCamera: the 64-byte RSTemporalCamera of MacLauncher's graphics pipeline.
+struct RSTemporalCamera {
+  uint32_t size, version, flags, reserved;
+  uint64_t frameId, viewportId;
+  float nearPlane, farPlane, verticalFov, frameTimeMs; // positive view distances; radians
+  uint32_t reserved2[4];
+};
+static_assert(sizeof(RSTemporalCamera) == 64, "RSTemporalCamera is 64 bytes");
+enum : uint32_t { RS_TEMPORAL_CAMERA_FLAGS = 0x6f, RS_TEMPORAL_DEPTH_INFINITE = 4 };
+static thread_local RSTemporalCamera temporal_camera;
+
+static bool ValidCamera(const RSTemporalCamera *c) {
+  if (!c || c->size != sizeof(*c) || c->version != 1 || c->reserved || (c->flags & ~RS_TEMPORAL_CAMERA_FLAGS) ||
+      !c->frameId || !std::isfinite(c->nearPlane) || c->nearPlane <= 0 || !std::isfinite(c->verticalFov) ||
+      c->verticalFov <= 0 || c->verticalFov >= 3.14159265358979323846f || !std::isfinite(c->frameTimeMs) ||
+      c->frameTimeMs < 0)
+    return false;
+  for (auto reserved : c->reserved2)
+    if (reserved)
+      return false;
+  return c->flags & RS_TEMPORAL_DEPTH_INFINITE ? c->farPlane == 0
+                                               : std::isfinite(c->farPlane) && c->farPlane > c->nearPlane;
+}
+
+extern "C" __declspec(dllexport) int __cdecl MacLauncherSetTemporalCamera(const RSTemporalCamera *camera) {
+  temporal_camera = ValidCamera(camera) ? *camera : RSTemporalCamera{};
+  return temporal_camera.size != 0;
+}
+
+extern "C" __declspec(dllexport) void __cdecl MacLauncherClearTemporalCamera() { temporal_camera = {}; }
