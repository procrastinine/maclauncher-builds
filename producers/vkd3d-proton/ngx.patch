+// a device's queue as DXVK's interop shows it; where its driver names "temporal-sr", the command buffers and fences
+// that carry the frames, used in turn
+struct Queue11 {
+  static constexpr unsigned SLOTS = 4;
+  VkDevice device = VK_NULL_HANDLE;
+  VkQueue queue = VK_NULL_HANDLE;
+  bool temporal_sr = false;
+  std::mutex mutex;
+  VkCommandPool pool = VK_NULL_HANDLE;
+  VkCommandBuffer commands[SLOTS] = {};
+  VkFence fences[SLOTS] = {};
+  bool pending[SLOTS] = {};
+  unsigned next = 0;
+  PFN_vkDestroyCommandPool DestroyCommandPool = nullptr;
+  PFN_vkResetCommandBuffer ResetCommandBuffer = nullptr;
+  PFN_vkBeginCommandBuffer BeginCommandBuffer = nullptr;
+  PFN_vkEndCommandBuffer EndCommandBuffer = nullptr;
+  PFN_vkCmdPipelineBarrier2 CmdPipelineBarrier2 = nullptr;
+  PFN_vkQueueSubmit QueueSubmit = nullptr;
+  PFN_vkDestroyFence DestroyFence = nullptr;
+  PFN_vkWaitForFences WaitForFences = nullptr;
+  PFN_vkResetFences ResetFences = nullptr;
+
+  ~Queue11() {
+    for (unsigned i = 0; i < SLOTS; i++) {
+      if (pending[i])
+        WaitForFences(device, 1, &fences[i], VK_TRUE, UINT64_MAX);
+      if (fences[i])
+        DestroyFence(device, fences[i], nullptr);
+    }
+    if (pool)
+      DestroyCommandPool(device, pool, nullptr); // and its command buffers
+  }
+};
 
