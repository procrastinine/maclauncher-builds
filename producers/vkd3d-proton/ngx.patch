+static bool CreateCommands11(Queue11 &q, PFN_vkGetDeviceProcAddr proc, uint32_t family) {
+  PFN_vkCreateCommandPool CreateCommandPool;
+  PFN_vkAllocateCommandBuffers AllocateCommandBuffers;
+  PFN_vkCreateFence CreateFence;
+  VkDevice d = q.device;
+  if (!Load(proc, d, "vkCreateCommandPool", CreateCommandPool) ||
+      !Load(proc, d, "vkAllocateCommandBuffers", AllocateCommandBuffers) || !Load(proc, d, "vkCreateFence", CreateFence) ||
+      !Load(proc, d, "vkDestroyCommandPool", q.DestroyCommandPool) ||
+      !Load(proc, d, "vkResetCommandBuffer", q.ResetCommandBuffer) ||
+      !Load(proc, d, "vkBeginCommandBuffer", q.BeginCommandBuffer) ||
+      !Load(proc, d, "vkEndCommandBuffer", q.EndCommandBuffer) ||
+      !Load(proc, d, "vkCmdPipelineBarrier2", q.CmdPipelineBarrier2) ||
+      !Load(proc, d, "vkQueueSubmit", q.QueueSubmit) || !Load(proc, d, "vkDestroyFence", q.DestroyFence) ||
+      !Load(proc, d, "vkWaitForFences", q.WaitForFences) || !Load(proc, d, "vkResetFences", q.ResetFences))
+    return false;
+  VkCommandPoolCreateInfo pool = {VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO, nullptr,
+                                  VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT, family};
+  if (CreateCommandPool(d, &pool, nullptr, &q.pool) != VK_SUCCESS) {
+    q.pool = VK_NULL_HANDLE;
+    return false;
+  }
+  VkCommandBufferAllocateInfo allocate = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO, nullptr, q.pool,
+                                          VK_COMMAND_BUFFER_LEVEL_PRIMARY, Queue11::SLOTS};
+  if (AllocateCommandBuffers(d, &allocate, q.commands) != VK_SUCCESS)
+    return false;
+  VkFenceCreateInfo fence = {VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  for (auto &f : q.fences)
+    if (CreateFence(d, &fence, nullptr, &f) != VK_SUCCESS) {
+      f = VK_NULL_HANDLE;
+      return false;
+    }
+  return true;
+}
