 NVNGX_EXPORT NVNGX_RESULT NVSDK_NGX_D3D11_Shutdown1(ID3D11Device *device) {
+  IDXGIVkInteropDevice *interop = Interop11(device);
+  if (!interop)
+    return NVNGX_RESULT_OK;
+  VkDevice handle;
+  interop->GetVulkanHandles(nullptr, nullptr, &handle);
+  interop->Release();
+  std::lock_guard<std::mutex> lock(queues11_mutex);
+  queues11.erase(std::remove_if(queues11.begin(), queues11.end(), [&](auto &q) { return q->device == handle; }),
+                 queues11.end());
   return NVNGX_RESULT_OK;
 }
 
