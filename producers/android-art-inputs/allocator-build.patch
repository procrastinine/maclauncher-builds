+// Original HAL implementation, with one standard strong-reference handoff.
+#[allow(dead_code)]
+#[path = "main.rs"]
+mod implementation;
+#[unsafe(no_mangle)]
+pub extern "C" fn maclauncher_art_allocator() -> *mut std::ffi::c_void {
