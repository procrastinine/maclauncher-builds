{
  "schemaVersion": 1,
  "version": "sdl2-fonts-macos13-v1",
  "architecture": "arm64",
  "minimumMacOS": "13.0",
  "dependencies": [
    {
      "id": "sdl2",
      "name": "SDL2",
      "version": "2.32.10",
      "options": [
        "-DSDL_SHARED=ON",
        "-DSDL_STATIC=OFF",
        "-DSDL_TEST=OFF",
        "-DSDL_TESTS=OFF"
      ]
    },
    {
      "id": "libpng",
      "name": "libpng",
      "version": "1.6.59",
      "options": [
        "-DPNG_SHARED=ON",
        "-DPNG_STATIC=OFF",
        "-DPNG_FRAMEWORK=OFF",
        "-DPNG_TESTS=OFF",
        "-DPNG_TOOLS=OFF",
        "-DPNG_EXECUTABLES=OFF"
      ]
    },
    {
      "id": "freetype",
      "name": "FreeType",
      "version": "2.14.3",
      "options": [
        "-DFT_DISABLE_HARFBUZZ=ON",
        "-DFT_DISABLE_BROTLI=ON",
        "-DFT_REQUIRE_ZLIB=ON",
        "-DFT_REQUIRE_PNG=ON",
        "-DFT_REQUIRE_BZIP2=ON"
      ]
    },
    {
      "id": "graphite2",
      "name": "Graphite2",
      "version": "1.3.15",
      "options": []
    },
    {
      "id": "harfbuzz",
      "name": "HarfBuzz",
      "version": "14.6.0",
      "options": [
        "-DHB_HAVE_FREETYPE=ON",
        "-DHB_HAVE_GRAPHITE2=ON",
        "-DHB_HAVE_CORETEXT=ON",
        "-DHB_HAVE_GLIB=OFF",
        "-DHB_HAVE_GOBJECT=OFF",
        "-DHB_HAVE_INTROSPECTION=OFF",
        "-DHB_HAVE_ICU=OFF",
        "-DHB_HAVE_CAIRO=OFF",
        "-DHB_BUILD_SUBSET=OFF",
        "-DHB_BUILD_RASTER=OFF",
        "-DHB_BUILD_VECTOR=OFF",
        "-DHB_BUILD_GPU=OFF",
        "-DHB_BUILD_GPU_DEMO=OFF",
        "-DHB_BUILD_UTILS=OFF",
        "-DBUILD_FRAMEWORK=OFF"
      ]
    },
    {
      "id": "sdl2_ttf",
      "name": "SDL2_ttf",
      "version": "2.24.0",
      "options": [
        "-DSDL2TTF_VENDORED=OFF",
        "-DSDL2TTF_SAMPLES=OFF",
        "-DSDL2TTF_INSTALL=ON",
        "-DSDL2TTF_HARFBUZZ=ON"
      ]
    }
  ]
}
