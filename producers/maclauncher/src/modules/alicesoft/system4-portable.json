{
  "schemaVersion": 1,
  "version": "xsystem4-dependencies-macos13-v1",
  "architecture": "arm64",
  "minimumMacOS": "13.0",
  "dependencies": [
    {
      "id": "libffi",
      "name": "libffi",
      "version": "3.8.0",
      "archiveUrl": "https://github.com/libffi/libffi/releases/download/v3.8.0/libffi-3.8.0.tar.gz",
      "buildSystem": "autotools",
      "options": [
        "--enable-shared",
        "--disable-static",
        "--disable-docs",
        "--disable-dependency-tracking"
      ],
      "repository": "https://github.com/libffi/libffi"
    },
    {
      "id": "turbojpeg",
      "name": "libjpeg-turbo",
      "version": "3.2.0",
      "buildSystem": "cmake",
      "options": [
        "-DENABLE_SHARED=ON",
        "-DENABLE_STATIC=OFF",
        "-DWITH_TOOLS=OFF",
        "-DWITH_TESTS=OFF",
        "-DWITH_TURBOJPEG=ON",
        "-DWITH_SIMD=ON",
        "-DBUILD=maclauncher-portable-v2"
      ]
    },
    {
      "id": "cglm",
      "name": "cglm",
      "version": "0.9.6",
      "buildSystem": "cmake",
      "options": [
        "-DCGLM_SHARED=ON",
        "-DCGLM_STATIC=OFF",
        "-DCGLM_USE_TEST=OFF"
      ]
    },
    {
      "id": "glew",
      "name": "GLEW",
      "version": "2.3.1",
      "buildSystem": "cmake",
      "sourceSubdirectory": "build/cmake",
      "options": [
        "-DBUILD_UTILS=OFF",
        "-DBUILD_FRAMEWORK=OFF",
        "-DGLEW_X11=OFF",
        "-DGLEW_EGL=OFF",
        "-DGLEW_OSMESA=OFF",
        "-DGLEW_REGAL=OFF"
      ]
    },
    {
      "id": "webp",
      "options": [
        "-DWEBP_BUILD_ANIM_UTILS=OFF",
        "-DWEBP_BUILD_CWEBP=OFF",
        "-DWEBP_BUILD_DWEBP=OFF",
        "-DWEBP_BUILD_GIF2WEBP=OFF",
        "-DWEBP_BUILD_IMG2WEBP=OFF",
        "-DWEBP_BUILD_VWEBP=OFF",
        "-DWEBP_BUILD_WEBPINFO=OFF",
        "-DWEBP_BUILD_WEBPMUX=OFF",
        "-DWEBP_BUILD_EXTRAS=OFF",
        "-DWEBP_BUILD_FUZZTEST=OFF"
      ],
      "version": "1.6.0"
    }
  ]
}
